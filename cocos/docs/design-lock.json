{
  "$schema": "https://blackholerecycle.local/schemas/design-lock-v2.json",
  "version": 1,
  "designSpace": {
    "width": 720,
    "height": 1280,
    "origin": "center",
    "referenceCoordinateSystem": "top-left"
  },
  "policy": {
    "editorOnlyReferenceAssets": true,
    "forbidSceneMutationFromOverlay": true,
    "requiredEvidence": [
      "reference_blueprint",
      "creator_actual_bounds",
      "overlay_or_diff_report",
      "runtime_screenshot",
      "independent_subgate_results"
    ],
    "subgates": [
      "layout",
      "style",
      "typography",
      "color",
      "asset",
      "elements"
    ],
    "lockRule": "Only all-PASS subgates with current evidence may set status to LOCKED."
  },
