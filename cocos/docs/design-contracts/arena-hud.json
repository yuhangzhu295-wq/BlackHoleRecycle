  "eventWiring": {
    "updateMatch": {
      "caller": "GameManager.updateHUD -> HUDView.updateArena",
      "callee": "ArenaHUDController.updateMatch",
      "snapshotSource": "ArenaMatchManager.getSnapshot (authoritative)"
    },
    "onObjectAbsorbed": {
      "caller": "GameManager.onObjectAbsorbed",
      "callee": "HUDView.showAbsorbFeedback -> ArenaHUDController.showAbsorbFeedback -> PickupFeedbackPresenter.emit"
    },
    "pauseTrigger": {
      "caller": "ArenaHUDController.onEnable (BtnPause)",
      "event": "UI_TRIGGER_PAUSE",
      "handler": "GameManager (eventBus.on UI_TRIGGER_PAUSE -> togglePause)"
    },
    "joystickInput": {
      "reader": "JoystickVisual.update",
      "source": "PlayerController.moveInput",
      "target": "JoystickKnob.setPosition"
    }
  },
  "invariants": [
    "ArenaHUD must exist as direct child of Canvas in Game.scene with size 720x1280",
    "LeaderboardPanel, TopRow1..5, Top1..5, TimerPanel, TimerValue, StatusPanel, RankValue, MassValue, KillCaption, KillValue, StatusValue, BtnPause, arrows, and Joystick are direct children of ArenaHUD in Game.scene",
    "BtnPause has BtnPauseLabel as direct child",
    "BotArrowLeft/Right/Top/Bottom have BotArrow*Label direct children and are inactive by default",
    "Joystick has JoystickBase and JoystickKnob as direct children and retains JoystickVisual component",
    "ArenaHUDController updates stats strictly from real ArenaMatchSnapshot without hardcoded values",
    "Projection for competitor nameplates and direction arrows must use the 3D gameplay camera (Main Camera)",
    "JoystickVisual reads input strictly from PlayerController.moveInput",
    "No HUD UI production script may depend on QA mutation APIs"
  ]
}
