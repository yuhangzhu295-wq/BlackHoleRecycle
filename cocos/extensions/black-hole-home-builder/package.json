{
  "package_version": 2,
  "name": "black-hole-home-builder",
  "version": "1.0.0",
  "description": "Create and validate editor-saved V2 UI prefabs through Cocos Creator APIs.",
  "author": "BlackHoleRecycle",
  "editor": ">=3.8.3",
  "main": "./main.js",
  "contributions": {
    "builder": "./builder.js",
    "scene": { "script": "./scene.js" },
    "menu": [
      {
        "path": "i18n:menu.extension",
        "label": "创建 V2 五级回收机视觉（编辑器保存）",
        "message": "build-machine-visuals"
      },
      {
        "path": "i18n:menu.extension",
        "label": "验证 V2 五级回收机视觉",
        "message": "verify-machine-visuals"
      },
      {
        "path": "i18n:menu.extension",
        "label": "清理 V2 回收机预制体临时节点（编辑器保存）",
        "message": "cleanup-machine-visual-residue"
      },
      {
        "path": "i18n:menu.extension",
        "label": "安装 V2 履带回收机底盘（编辑器保存）",
        "message": "install-machine-chassis-template"
      },
      {
        "path": "i18n:menu.extension",
        "label": "验证 V2 履带回收机底盘",
        "message": "verify-machine-chassis-template"
      },
      {
        "path": "i18n:menu.extension",
        "label": "安装 V2 回收物语义模型（编辑器保存）",
        "message": "install-object-art-registry"
      },
      {
        "path": "i18n:menu.extension",
        "label": "验证 V2 回收物语义模型",
        "message": "verify-object-art-registry"
      },
      {
        "path": "i18n:menu.extension",
        "label": "归一化 V2 世界美术尺寸（编辑器保存）",
        "message": "normalize-world-art-units"
      },
      {
        "path": "i18n:menu.extension",
        "label": "安装 V2 二维无限世界（编辑器保存）",
        "message": "install-infinite-world"
      },
      {
        "path": "i18n:menu.extension",
        "label": "验证 V2 二维无限世界",
        "message": "verify-infinite-world"
      },
      {
        "path": "i18n:menu.extension",
        "label": "添加 V2 可见摇杆（编辑器保存）",
        "message": "add-joystick-overlay"
      },
      {
        "path": "i18n:menu.extension",
        "label": "导入 V2 Home Sprite 资源",
        "message": "prepare-home-sprites"
      },
      {
        "path": "i18n:menu.extension",
        "label": "创建 V2 HomePage（编辑器保存）",
        "message": "build-home"
      },
      {
        "path": "i18n:menu.extension",
        "label": "验证 V2 HomePage",
        "message": "verify-home"
      },
      {
        "path": "i18n:menu.extension",
        "label": "导入 V2 模式选择资源",
        "message": "prepare-mode-sprites"
      },
      {
        "path": "i18n:menu.extension",
        "label": "创建 V2 ModeSelectPage（编辑器保存）",
        "message": "build-mode-select"
      },
      {
        "path": "i18n:menu.extension",
        "label": "验证 V2 ModeSelectPage",
        "message": "verify-mode-select"
      },
      {
        "path": "i18n:menu.extension",
        "label": "安装 V2 竞技乱斗实体管理器（编辑器保存）",
        "message": "install-arena-match"
      },
      {
        "path": "i18n:menu.extension",
        "label": "验证 V2 竞技乱斗实体管理器",
        "message": "verify-arena-match"
      },
      {
        "path": "i18n:menu.extension",
        "label": "创建 V2 运行时 HUD、暂停页与结算页（编辑器保存）",
        "message": "build-runtime-pages"
      },
      {
        "path": "i18n:menu.extension",
        "label": "验证 V2 运行时页面",
        "message": "verify-runtime-pages"
      }
    ],
    "messages": {
      "build-machine-visuals": { "methods": ["buildMachineVisuals"] },
      "verify-machine-visuals": { "methods": ["verifyMachineVisuals"] },
      "cleanup-machine-visual-residue": { "methods": ["cleanupMachineVisualResidue"] },
      "install-machine-chassis-template": { "methods": ["installMachineChassisTemplate"] },
      "verify-machine-chassis-template": { "methods": ["verifyMachineChassisTemplate"] },
      "install-object-art-registry": { "methods": ["installObjectArtRegistry"] },
      "verify-object-art-registry": { "methods": ["verifyObjectArtRegistry"] },
      "normalize-world-art-units": { "methods": ["normalizeWorldArtUnits"] },
      "install-infinite-world": { "methods": ["installInfiniteWorld"] },
      "verify-infinite-world": { "methods": ["verifyInfiniteWorld"] },
      "add-joystick-overlay": { "methods": ["addJoystickOverlay"] },
      "prepare-home-sprites": { "methods": ["prepareHomeSprites"] },
      "build-home": { "methods": ["buildHome"] },
      "verify-home": { "methods": ["verifyHome"] },
      "prepare-mode-sprites": { "methods": ["prepareModeSprites"] },
      "build-mode-select": { "methods": ["buildModeSelect"] },
      "verify-mode-select": { "methods": ["verifyModeSelect"] },
      "install-arena-match": { "methods": ["installArenaMatch"] },
      "verify-arena-match": { "methods": ["verifyArenaMatch"] },
      "build-runtime-pages": { "methods": ["buildRuntimePages"] },
      "verify-runtime-pages": { "methods": ["verifyRuntimePages"] }
    }
  }
}
